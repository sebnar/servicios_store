# Dockerfile optimizado para Render.com
FROM node:18-alpine

# Instalar dependencias del sistema
RUN apk add --no-cache dumb-init

# Crear directorios necesarios
RUN mkdir -p /app/backend /app/frontend /app/uploads

# Establecer directorio de trabajo
WORKDIR /app

# Copiar archivos del backend
COPY backend/package*.json ./backend/
COPY backend/ ./backend/

# Copiar archivos del frontend
COPY frontend/package*.json ./frontend/
COPY frontend/ ./frontend/

# Instalar dependencias del backend
WORKDIR /app/backend
RUN npm ci --only=production

# Instalar dependencias del frontend y construir
WORKDIR /app/frontend
RUN npm ci && npm run build

# Volver al directorio raíz
WORKDIR /app

# Crear script de inicio para Render
RUN echo '#!/bin/bash\n\
echo "🚀 Iniciando Servicios Store en Render..."\n\
\n\
# Variables de entorno\n\
export NODE_ENV=production\n\
export PORT=${PORT:-5000}\n\
export MONGODB_URI=${MONGODB_URI}\n\
export JWT_SECRET=${JWT_SECRET:-servicios_store_jwt_secret_2024}\n\
\n\
# Iniciar Backend\n\
echo "🔧 Iniciando Backend..."\n\
cd /app/backend\n\
npm start &\n\
BACKEND_PID=$!\n\
\n\
# Esperar a que el backend esté listo\n\
echo "⏳ Esperando a que Backend esté listo..."\n\
sleep 3\n\
\n\
# Iniciar Frontend\n\
echo "🌐 Iniciando Frontend..."\n\
cd /app/frontend\n\
npm run preview -- --host 0.0.0.0 --port 3000 &\n\
FRONTEND_PID=$!\n\
\n\
# Esperar a que el frontend esté listo\n\
echo "⏳ Esperando a que Frontend esté listo..."\n\
sleep 3\n\
\n\
echo "✅ Servicios iniciados correctamente!"\n\
echo "🌐 URLs de acceso:"\n\
echo "   Frontend: http://localhost:3000"\n\
echo "   Backend API: http://localhost:${PORT}"\n\
\n\
# Mantener el script ejecutándose\n\
wait\n\
' > /app/start-render.sh && chmod +x /app/start-render.sh

# Variables de entorno
ENV NODE_ENV=production
ENV PORT=5000

# Exponer puertos
EXPOSE 3000 5000

# Comando de inicio
CMD ["dumb-init", "/app/start-render.sh"]
