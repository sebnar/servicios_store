# Dockerfile para MongoDB en Render
FROM mongo:7.0

# Crear directorio de datos
RUN mkdir -p /data/db

# Configurar MongoDB
ENV MONGO_INITDB_ROOT_USERNAME=admin
ENV MONGO_INITDB_ROOT_PASSWORD=password123
ENV MONGO_INITDB_DATABASE=servicios_store

# Exponer puerto
EXPOSE 27017

# Comando de inicio
CMD ["mongod", "--bind_ip_all", "--port", "27017"]
